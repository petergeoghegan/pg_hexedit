#!/usr/bin/env python3
"""
pg_hexedit_live_bridge: serve a PostgreSQL relation's pages to ImHex, live.

Speaks the GDB remote serial protocol that ImHex's built-in "GDB Server"
provider understands, and translates memory reads into
contrib/pageinspect's get_raw_page(), which reads from shared_buffers --
so the bytes ImHex sees are the server's current view of the relation
(dirty pages included), not the possibly-stale filesystem copy.

Address space: byte offset into the relation's first segment
(block * BLCKSZ + offset), exactly like a relation file, so patterns
generated by pg_hexedit work unchanged.

The provider is read-only: GDB write packets are refused.  Editing pages
still goes through the filesystem workflow.

Usage:
  pg_hexedit_live_bridge RELNAME [--port PORT] [--blcksz BYTES]

Connection details come from the usual libpq environment variables
(PGHOST, PGPORT, PGDATABASE, ...), like the other convenience scripts.
Requires contrib/pageinspect in the target database.
"""

import argparse
import os
import selectors
import socket
import subprocess
import sys
import threading
import time

BLCKSZ = 8192


def load_config():
    """Source hexedit.cfg (like the bash convenience scripts do) and adopt
    the PG* variables it exports, overriding the inherited environment the
    same way sourcing it in a shell would."""
    cfg = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                       "hexedit.cfg")
    if not os.path.exists(cfg):
        return
    try:
        out = subprocess.run(
            ["bash", "-c", f'source "{cfg}" > /dev/null 2>&1 && env'],
            capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return
    for line in out.splitlines():
        if line.startswith("PG") and "=" in line:
            k, v = line.split("=", 1)
            if os.environ.get(k) != v:
                print(f"hexedit.cfg: {k}={v}")
            os.environ[k] = v
CACHE_TTL = 0.15                # seconds; freshness/chattiness trade-off
END_MARKER = "__PG_HEXEDIT_END__"

# Liveness bookkeeping for the idle reaper (see --idle-timeout)
ACTIVITY = {"clients": 0, "last": 0.0}


class Psql:
    """One persistent psql session, queried line-at-a-time."""

    def __init__(self):
        self.lock = threading.Lock()
        # stderr is inherited so that psql's own connection errors and query
        # error messages reach the terminal
        try:
            self.proc = subprocess.Popen(
                ["psql", "-XAtq", "-v", "ON_ERROR_STOP=0"],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        except FileNotFoundError:
            sys.exit("psql not found in $PATH")

    def query(self, sql):
        """Run one query, return its output lines."""
        with self.lock:
            self.proc.stdin.write(sql + "\n\\echo " + END_MARKER + "\n")
            self.proc.stdin.flush()
            lines = []
            while True:
                line = self.proc.stdout.readline()
                if line == "":
                    raise RuntimeError("psql exited")
                line = line.rstrip("\n")
                if line == END_MARKER:
                    return lines
                lines.append(line)

    def scalar(self, sql):
        lines = self.query(sql)
        return lines[0] if lines else None


# In-band metadata: the last 4KiB line of the advertised address space
# carries a magic tag and the live relation size, so patterns can size
# their page array to the real relation instead of the flush pad
META_MAGIC = 0x3147524258484750        # "PGHXBRG1", little-endian


class RelationPages:
    """Page fetcher with a short-TTL cache.

    mode "bufmgr" reads through contrib/pageinspect's get_raw_page(), i.e.
    from shared_buffers: the server's current view, dirty pages included.
    mode "file" reads through core pg_read_binary_file(): no extension at
    all, but only shows what has been written back to the segment file.
    """

    def __init__(self, psql, relname, blcksz, mode):
        self.psql = psql
        self.rel = relname.replace("'", "''")
        self.blcksz = blcksz
        self.mode = mode
        self.relpath = None
        if mode == "file":
            self.relpath = psql.scalar(
                f"SELECT pg_relation_filepath('{self.rel}');")
        self.cache = {}
        self.size = 0
        self.size_time = 0.0
        self.meta_tail = 0          # set in GDB mode: end of advertised space
        self.writable = False       # set in GDB mode when --writable + ext present
        self.refresh_size()

    def refresh_size(self):
        v = self.psql.scalar(
            f"SELECT pg_relation_size('{self.rel}');")
        if v is None:
            raise RuntimeError(f"relation {self.rel} not found")
        self.size = min(int(v), 131072 * self.blcksz)  # first segment only
        self.size_time = time.monotonic()

    def page(self, blk):
        now = time.monotonic()
        hit = self.cache.get(blk)
        if hit is not None and now - hit[1] < CACHE_TTL:
            return hit[0]
        if self.mode == "bufmgr":
            v = self.psql.scalar(
                f"SELECT encode(get_raw_page('{self.rel}', {blk}::int4), 'hex');")
        else:
            v = self.psql.scalar(
                f"SELECT encode(pg_read_binary_file('{self.relpath}', "
                f"{blk * self.blcksz}, {self.blcksz}, true), 'hex');")
        if v is None or len(v) != self.blcksz * 2:
            data = b"\x00" * self.blcksz
        else:
            data = bytes.fromhex(v)
        self.cache[blk] = (data, now)
        return data

    def write(self, addr, data):
        """Poke bytes into shared_buffers via pg_hexedit_poke, splitting at
        page boundaries.  Returns True on success."""
        blcksz = self.blcksz
        off = 0
        while off < len(data):
            if addr + off >= self.size:
                return False            # never write the flush pad / metadata
            blk = (addr + off) // blcksz
            boff = (addr + off) % blcksz
            n = min(len(data) - off, blcksz - boff)
            chunk = data[off:off + n]
            hexs = chunk.hex()
            self.psql.query(
                f"SELECT pg_hexedit_poke('{self.rel}', {blk}, {boff}, "
                f"decode('{hexs}', 'hex'));")
            self.cache.pop(blk, None)   # force a fresh read next time
            print(f"write: block {blk} offset {boff} {n} byte(s) "
                  f"-> shared_buffers (live, no save needed)")
            off += n
        return True

    def read(self, addr, length):
        # Track relation growth without querying per-read
        if time.monotonic() - self.size_time > 2.0:
            self.refresh_size()
        out = bytearray()
        while length > 0:
            if self.meta_tail and addr >= self.meta_tail - 4096:
                # metadata line: magic + live relation size
                line = (META_MAGIC.to_bytes(8, "little")
                        + self.size.to_bytes(8, "little"))
                line += b"\x00" * (4096 - len(line))
                off = addr - (self.meta_tail - 4096)
                n = min(length, 4096 - off) if off < 4096 else length
                out += (line[off:off + n] if off < 4096 else b"\x00" * n)
                addr += n
                length -= n
                continue
            if addr >= self.size:
                # Flush-pad sentinel: 0xFF makes pd_pagesize_version read
                # 0xFFFF, which the pattern uses to stop the page array (a
                # value no real page has), so a mismatched provider size can
                # never turn the pad into bogus pages.
                out += b"\xff" * length
                break
            blk = addr // self.blcksz
            off = addr % self.blcksz
            n = min(length, self.blcksz - off)
            out += self.page(blk)[off:off + n]
            addr += n
            length -= n
        return bytes(out)


def checksum(payload: bytes) -> bytes:
    return b"%02x" % (sum(payload) % 256)


# Repeat-count characters that would confuse the packet reader
RLE_FORBIDDEN = {ord("#"), ord("$"), ord("*"), ord("+"), ord("-")}


def rle_encode(hexstr: bytes) -> bytes:
    """Run-length encode a memory response the way ImHex decodes it:
    "c*n" expands to chr(n)-29 copies of c (the triple replaces the run).
    Long runs of the same character (zero pages, the cache-flush region)
    shrink dramatically, which matters because ImHex parses responses one
    character at a time."""
    out = bytearray()
    i = 0
    n = len(hexstr)
    while i < n:
        c = hexstr[i]
        run = 1
        while i + run < n and hexstr[i + run] == c and run < 4096:
            run += 1
        i += run
        while run >= 4:
            take = min(run, 97)
            while take + 29 in RLE_FORBIDDEN and take > 3:
                take -= 1
            if take <= 3:
                break
            out += bytes((c, ord("*"), take + 29))
            run -= take
        out += bytes((c,)) * run
    return bytes(out)


def serve(conn, pages):
    """Handle one GDB remote serial protocol client."""
    buf = b""
    stats = {"reads": 0, "tail": 0, "blocks": set(), "last": 0.0,
             "start": 0.0}

    def flush_stats():
        if stats["reads"]:
            nrel = len(stats["blocks"])
            sweep = " (cache-flush sweep seen)" if stats["tail"] >= 1024 else ""
            secs = max(stats["last"] - stats["start"], 1e-9)
            print(f"burst: {stats['reads']} reads in {secs:.2f}s "
                  f"({stats['reads'] / secs:.0f}/s), {stats['tail']} in flush "
                  f"region, {nrel} distinct relation block(s){sweep}")
            if stats["reads"] >= 500 and stats["tail"] == 0:
                print("WARNING: a large burst with no flush-region reads -- "
                      "the ImHex provider was probably created without the "
                      "padded size, so re-evaluation will show STALE bytes.")
                print(f"         Re-create the GDB provider with size "
                      f"{pages.size + 8 * 1024 * 1024} "
                      f"(0x{pages.size + 8 * 1024 * 1024:X}).")
            stats.update(reads=0, tail=0, blocks=set())

    def track(addr, length):
        now = time.monotonic()
        if now - stats["last"] > 0.5:
            flush_stats()
            stats["start"] = now
        stats["last"] = now
        stats["reads"] += 1
        if addr >= pages.size:
            stats["tail"] += 1
        else:
            for b in range(addr // pages.blcksz,
                           min((addr + max(length, 1) - 1) // pages.blcksz + 1,
                               pages.size // pages.blcksz)):
                stats["blocks"].add(b)

    def send(payload: bytes):
        conn.sendall(b"+$" + payload + b"#" + checksum(payload))

    while True:
        data = conn.recv(65536)
        if not data:
            flush_stats()
            return
        buf += data
        while True:
            # Discard acks and interrupts before the next packet
            while buf[:1] in (b"+", b"-", b"\x03"):
                buf = buf[1:]
            start = buf.find(b"$")
            end = buf.find(b"#")
            if start == -1 or end == -1 or len(buf) < end + 3:
                break
            packet = buf[start + 1:end]
            buf = buf[end + 3:]

            ACTIVITY["last"] = time.monotonic()
            # Binary write packet: keep the raw bytes (ascii-decoding the
            # payload would corrupt it)
            if packet[:1] == b"X":
                if not pages.writable:
                    send(b"E01")
                    continue
                try:
                    colon = packet.index(b":")
                    hdr = packet[1:colon].decode("ascii")
                    addr_s, _len_s = hdr.split(",")
                    addr = int(addr_s, 16)
                    esc = packet[colon + 1:]
                    raw = bytearray()
                    j = 0
                    while j < len(esc):
                        if esc[j] == 0x7d:      # '}' escape: next byte ^ 0x20
                            raw.append(esc[j + 1] ^ 0x20)
                            j += 2
                        else:
                            raw.append(esc[j])
                            j += 1
                    send(b"OK" if pages.write(addr, bytes(raw)) else b"E01")
                except Exception as e:
                    sys.stderr.write(f"write (X) failed: {e}\n")
                    send(b"E01")
                continue

            cmd = packet.decode("ascii", "replace")
            if cmd.startswith("qSupported"):
                send(b"PacketSize=40000;QStartNoAckMode-")
            elif cmd == "?":
                send(b"S05")
            elif cmd == "g":
                send(b"00" * 64)
            elif cmd.startswith("p"):
                send(b"0000000000000000")
            elif cmd.startswith("m"):
                try:
                    addr_s, len_s = cmd[1:].split(",")
                    addr, length = int(addr_s, 16), int(len_s, 16)
                    track(addr, length)
                    send(rle_encode(pages.read(addr, length).hex().encode()))
                except Exception as e:
                    sys.stderr.write(f"read failed: {e}\n")
                    send(b"E01")
            elif cmd.startswith("M"):
                if not pages.writable:
                    send(b"E01")    # read-only
                else:
                    try:
                        hdr, hexdata = cmd[1:].split(":", 1)
                        addr_s, _len_s = hdr.split(",")
                        addr = int(addr_s, 16)
                        send(b"OK" if pages.write(addr, bytes.fromhex(hexdata))
                             else b"E01")
                    except Exception as e:
                        sys.stderr.write(f"write (M) failed: {e}\n")
                        send(b"E01")
            elif cmd.startswith(("H", "D", "!")):
                send(b"OK")
            elif cmd == "k":
                flush_stats()
                return
            else:
                send(b"")           # unsupported


def run_mirror(pages, args):
    """Keep a local mirror file of the relation in sync.

    ImHex's file provider reads straight through the filesystem (and shows a
    reload banner when it detects external changes), so a mirror file gives a
    view that stays current as the server modifies pages -- unlike the GDB
    provider, which caches reads until the provider is closed.  The mirror is
    created read-only so it cannot be mistaken for an editable relation file:
    edits here would be overwritten and never reach the server.
    """
    path = args.mirror
    if path == "":
        safe = "".join(c if c.isalnum() or c in "._-" else "_"
                       for c in args.relname)
        path = os.path.join(os.environ.get("TMPDIR", "/tmp"),
                            f"pg_hexedit_live_{safe}.heap")

    blcksz = pages.blcksz
    lo = max(args.window[0], 0)
    hi = args.window[1]
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    os.chmod(path, 0o444)       # existing fd stays writable
    last = {}
    first = True

    print(f"Mirroring relation \"{args.relname}\" to {path}")
    print(f"Refreshing blocks {lo}-{hi} every {args.interval}s; "
          "other blocks written once.")
    print("Open the mirror in ImHex like any relation file, e.g.:")
    print(f"  imhex --open {path}")
    print("The file is read-only on purpose: edits to a mirror never reach "
          "the server.")
    print("Ctrl+C to stop.")

    while True:
        pages.refresh_size()
        os.truncate(fd, pages.size)
        nblocks = pages.size // blcksz
        changed = 0
        for blk in range(nblocks):
            if not first and not (lo <= blk <= hi):
                continue
            data = pages.page(blk)
            if last.get(blk) != data:
                os.pwrite(fd, data, blk * blcksz)
                last[blk] = data
                changed += 1
        if first:
            print(f"initial mirror written ({nblocks} blocks)")
            first = False
        elif changed:
            print(f"refreshed {changed} changed block(s)")
        time.sleep(args.interval)


def main():
    ap = argparse.ArgumentParser(
        description="Serve a PostgreSQL relation to ImHex's GDB Server "
                    "provider, reading pages live from shared_buffers")
    ap.add_argument("relname")
    ap.add_argument("--port", type=int, default=4441)
    ap.add_argument("--blcksz", type=int, default=BLCKSZ)
    ap.add_argument("--mirror", nargs="?", const="", metavar="PATH",
                    help="instead of serving the GDB protocol, keep a local "
                         "mirror file in sync and let ImHex open it as a "
                         "plain (read-only) file")
    ap.add_argument("--interval", type=float, default=1.0,
                    help="mirror refresh interval in seconds (default 1.0)")
    ap.add_argument("--window", nargs=2, type=int, default=[0, 200],
                    metavar=("MIN", "MAX"),
                    help="block range kept fresh in mirror mode "
                         "(default 0 200); other blocks are written once")
    ap.add_argument("--idle-timeout", type=int, default=1800,
                    help="exit when no client is connected and nothing "
                         "happened for this many seconds (default 1800; "
                         "0 disables), so forgotten bridges clean "
                         "themselves up")
    ap.add_argument("--writable", action="store_true",
                    help="allow ImHex edits to write back into shared_buffers "
                         "via the pg_hexedit_poke extension (dev only, not "
                         "crash safe); default is read-only")
    args = ap.parse_args()

    # Keep status output visible when stdout is redirected
    sys.stdout.reconfigure(line_buffering=True)

    # Mirror all output to a log file: staleness reports are diagnosable
    # from the burst lines even after the terminal is gone
    class Tee:
        def __init__(self, *streams):
            self.streams = streams
        def write(self, s):
            for st in self.streams:
                st.write(s)
        def flush(self):
            for st in self.streams:
                st.flush()
    logpath = os.path.join(os.environ.get("TMPDIR", "/tmp"),
                           "pg_hexedit_live_bridge.log")
    try:
        logf = open(logpath, "a", buffering=1)
        sys.stdout = Tee(sys.stdout, logf)
        sys.stderr = Tee(sys.stderr, logf)
        print(f"log: {logpath} (pid {os.getpid()})")
    except OSError:
        pass

    # Only one bridge may run at a time: multiple bridges mean multiple
    # ports and multiple half-stale ImHex providers, a reliable source of
    # confusion.  Refuse to start alongside another instance.
    try:
        if os.environ.get("PG_HEXEDIT_BRIDGE_MULTI"):
            raise FileNotFoundError
        out = subprocess.run(["pgrep", "-f", "pg_hexedit_live_bridge"],
                             capture_output=True, text=True).stdout
        others = [p for p in out.split() if p.isdigit()
                  and int(p) != os.getpid()]
    except FileNotFoundError:
        others = []
    if others:
        sys.exit(f"another pg_hexedit_live_bridge is already running "
                 f"(pid {', '.join(others)}); only one may run at a time.\n"
                 f"Stop it first (Ctrl+C in its terminal, or "
                 f"kill {' '.join(others)}) and retry.")

    load_config()
    psql = Psql()
    try:
        if psql.scalar("SELECT 1;") != "1":
            raise RuntimeError("unexpected psql output")
    except RuntimeError:
        sys.exit(
            "\ncould not connect through psql (its error message should "
            "appear above).\n"
            "Check that the server is running and that the usual libpq "
            "environment\n"
            "variables are set -- note psql connects to a database named "
            "after your OS\n"
            "user by default.  Running through ./live_hexedit sources "
            "hexedit.cfg, which\n"
            "can set PGDATABASE, PGPORT, and friends.")

    # Prefer shared_buffers reads via contrib/pageinspect (standard contrib,
    # no third-party server code); fall back to core pg_read_binary_file()
    # when even contrib is unavailable.
    mode = "bufmgr"
    if psql.scalar("SELECT count(*) FROM pg_extension "
                   "WHERE extname = 'pageinspect';") != "1":
        psql.query("CREATE EXTENSION IF NOT EXISTS pageinspect;")
        if psql.scalar("SELECT count(*) FROM pg_extension "
                       "WHERE extname = 'pageinspect';") != "1":
            mode = "file"
            print("note: pageinspect unavailable; falling back to "
                  "pg_read_binary_file() (file contents, not shared_buffers)")
    print("connected: "
          + psql.scalar("SELECT current_database() || ' as ' || current_user"
                        " || ', server ' || current_setting("
                        "'server_version');"))

    try:
        pages = RelationPages(psql, args.relname, args.blcksz, mode)
    except RuntimeError as e:
        sys.exit(str(e))

    if args.writable and mode == "bufmgr":
        if psql.scalar("SELECT count(*) FROM pg_proc "
                       "WHERE proname = 'pg_hexedit_poke';") != "1":
            psql.query("CREATE EXTENSION IF NOT EXISTS pg_hexedit_poke;")
        if psql.scalar("SELECT count(*) FROM pg_proc "
                       "WHERE proname = 'pg_hexedit_poke';") == "1":
            pages.writable = True
        else:
            print("writable: requested but pg_hexedit_poke extension is not "
                  "available; staying READ-ONLY")
            print("  (build and install pg_hexedit_poke/, then "
                  "CREATE EXTENSION pg_hexedit_poke)")
    elif args.writable:
        print("writable: ignored in mirror/file mode (read-only)")

    if args.mirror is not None:
        try:
            run_mirror(pages, args)
        except KeyboardInterrupt:
            print("\nstopping")
        return

    # Listen on both loopback families: macOS resolves "localhost" to ::1
    # first, so an IPv4-only listener looks like a dead server to ImHex
    servers = []
    for family, addr in ((socket.AF_INET, "127.0.0.1"),
                         (socket.AF_INET6, "::1")):
        try:
            s = socket.socket(family, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if family == socket.AF_INET6:
                s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            s.bind((addr, args.port))
            s.listen(1)
            servers.append(s)
        except OSError:
            pass
    if not servers:
        sys.exit(f"could not listen on port {args.port}: address in use?  "
                 f"Another bridge (or other listener) already holds it; stop "
                 f"it or pass --port with a different number.")
    sel = selectors.DefaultSelector()
    for s in servers:
        sel.register(s, selectors.EVENT_READ)
    # Advertise extra zero-filled space past the relation: patterns sweep it
    # to flush ImHex's provider read cache, so re-evaluation is always fresh
    flush_pad = 8 * 1024 * 1024
    adv = pages.size + flush_pad
    pages.meta_tail = adv

    # Getting the size right is critical and error-prone by hand (ImHex's
    # size input is hexadecimal, and its recents list resurrects old
    # settings), so write a ready-made provider entry into ImHex's recents:
    # picking "GDB Server <127.0.0.1:PORT>" from File -> Recent gives a
    # provider with everything pre-set.
    import datetime
    import json
    for base in (os.path.expanduser("~/Library/Application Support/imhex"),
                 os.path.join(os.environ.get("XDG_DATA_HOME",
                              os.path.expanduser("~/.local/share")), "imhex")):
        rec = os.path.join(base, "recent")
        if not os.path.isdir(rec):
            continue
        try:
            # Repair any stale entries for this endpoint, then add a fresh one
            import glob
            for f in glob.glob(os.path.join(rec, "*.json")):
                try:
                    d = json.load(open(f))
                except Exception:
                    continue
                if (d.get("type") == "hex.builtin.provider.gdb"
                        and d.get("port") == args.port
                        and d.get("size") != adv):
                    d["size"] = adv
                    json.dump(d, open(f, "w"), indent=4)
            name = (datetime.datetime.now().strftime("%y%m%d_%H%M%S")
                    + "_pghexedit.json")
            entry = {"baseAddress": 0, "currPage": 0,
                     "displayName": f"GDB Server <127.0.0.1:{args.port}>",
                     "ip": "127.0.0.1", "port": args.port, "size": adv,
                     "type": "hex.builtin.provider.gdb"}
            json.dump(entry, open(os.path.join(rec, name), "w"), indent=4)
            print(f"recents: pre-configured provider entry written; after "
                  f"restarting ImHex use File -> Recent")
        except Exception as e:
            print(f"(could not update ImHex recents: {e})")
        break
    print(f"serving: {args.relname} "
          f"({pages.size // args.blcksz} blocks, {pages.size} bytes) "
          f"on localhost:{args.port}")
    print(f"provider: GDB Server, address 127.0.0.1, port {args.port}, "
          f"size 0x{adv:X} ({adv})")
    if pages.mode == "bufmgr":
        rw = "read-write (pg_hexedit_poke)" if pages.writable else "read-only"
        print(f"source: shared_buffers via get_raw_page() ({rw})")
    else:
        print("source: pg_read_binary_file() (read-only)")
    print("refresh: re-evaluate the pattern (play) in ImHex")
    print("stop: Ctrl+C")

    def handle(conn, addr):
        ACTIVITY["clients"] += 1
        ACTIVITY["last"] = time.monotonic()
        try:
            serve(conn, pages)
        except (ConnectionError, BrokenPipeError):
            pass
        except Exception:
            import traceback
            traceback.print_exc()
            print("(connection dropped after unexpected error; "
                  "bridge still running)")
        finally:
            conn.close()
            ACTIVITY["clients"] -= 1
            ACTIVITY["last"] = time.monotonic()
            print(f"client {addr[0]}:{addr[1]} disconnected")

    ACTIVITY["last"] = time.monotonic()
    if args.idle_timeout > 0:
        def reaper():
            while True:
                time.sleep(30)
                idle = time.monotonic() - ACTIVITY["last"]
                if ACTIVITY["clients"] == 0 and idle > args.idle_timeout:
                    print(f"no client and no activity for {int(idle)}s; "
                          "exiting (see --idle-timeout)")
                    os._exit(0)
        threading.Thread(target=reaper, daemon=True).start()

    try:
        # Serve connections concurrently: a lingering half-dead client must
        # never block a new provider's handshake in the accept backlog
        while True:
            events = sel.select()
            conn, addr = events[0][0].fileobj.accept()
            # Tiny request/reply ping-pong: Nagle delays are pure poison here
            conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            print(f"ImHex connected from {addr[0]}:{addr[1]}")
            threading.Thread(target=handle, args=(conn, addr),
                             daemon=True).start()
    except KeyboardInterrupt:
        print("\nstopping")


if __name__ == "__main__":
    main()
