#!/bin/bash
#
# btree_hexedit: Like relation_hexedit, but first prints the byte offsets of
# the B-Tree root page and the non-leaf children of the root, to paste into
# ImHex's "Goto" dialog for quick navigation.  (Pattern Data's per-block rows
# serve the same purpose once evaluation finishes.)

usage() {
  cat <<EOM
  Usage:
  $(basename "$0") relname

EOM
  exit 0
}

[ -z "$1" ] && { usage; }

source ./hexedit.cfg

relname=$1

if ! psql --no-psqlrc -c "CREATE EXTENSION IF NOT EXISTS pageinspect"
then
  echo "creating pageinspect extension failed"
  exit 1
fi

echo "Root page and non-leaf children of root (paste offsets into ImHex Goto):"
if ! psql --no-psqlrc -P pager=off -c "SELECT 'root' AS page, root AS block,
       (root * 2^13)::int8 AS offset_bytes FROM bt_metap('$relname')
UNION ALL
SELECT 'child of root', substring(ctid::text from '([0-9]+)')::int8,
       (substring(ctid::text from '([0-9]+)')::int8 * (2^13))::int8
FROM bt_page_items('$relname', (SELECT root::int4 FROM bt_metap('$relname') WHERE level > 1));"
then
  echo "obtaining root/children offsets failed; is $relname a btree?"
  exit 1
fi

./__open_relation "$relname"
