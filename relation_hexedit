#!/bin/bash
#
# relation_hexedit:  Annotate any relation and open it in ImHex.  This works
# with any kind of relation, and has no dependency on contrib/pageinspect
# (unless the relation file has to be downloaded through psql).

usage() {
  cat <<EOM
  Usage:
  $(basename "$0") relname

EOM
  exit 0
}

[ -z "$1" ] && { usage; }

source ./hexedit.cfg

relname=$1

./__open_relation "$relname"
