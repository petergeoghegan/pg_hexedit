#!/bin/bash
#
# Simple pg_hexedit smoke tests.  These are intended to be run by "make check",
# with the root directory as current working directory.
#
# pg_hexedit is a pure generator: its output is a function of the options and
# the PostgreSQL headers it was built against, so tests golden-compare
# generated patterns.  The leading provenance comment block (version,
# timestamp, build parameters) varies by build and is stripped before
# comparison.

# Strip the leading comment block (everything up to the first non-// line)
normalize() {
  awk 'skip == 0 && /^\/\// { next } { skip = 1; print }' "$1"
}

fail=0

check() {
  name=$1
  expected=$2
  output=$3

  normalize "$output" > "$output.norm"
  normalize "$expected" > "$output.expected.norm"
  if ! diff -u "$output.expected.norm" "$output.norm" > "t/$name.diff"
  then
    echo "Failed: $name"
    cat "t/$name.diff"
    fail=1
  else
    echo "ok: $name"
  fi
}

# Structure-only pattern (no tuple descriptor): annotates page headers, line
# pointers, tuple headers, special sections, and metapages for every AM
set -x
./pg_hexedit > t/output_no_attributes.hexpat || exit 1
set +x
check no_attributes t/expected_no_attributes.hexpat t/output_no_attributes.hexpat

# Legacy 3-value -D attribute list (no type OIDs)
ATTRLIST='4,"attrelid",i,64,"attname",c,4,"atttypid",i,2,"attlen",s,2,"attnum",s,1,"attalign",c,-1,"attacl",i'
set -x
./pg_hexedit -D "$ATTRLIST" > t/output_attributes_legacy.hexpat || exit 1
set +x
check attributes_legacy t/expected_attributes_legacy.hexpat t/output_attributes_legacy.hexpat

# Modern 4-value -A attribute list with type OIDs, including varlena columns,
# a dropped column, and an attribute name that is not a valid identifier
ATTRLIST='4,"id",i,23,1,"flag",c,16,8,"val",d,20,-1,"........pg.dropped.4........",i,0,-1,"name",i,25,-1,"strange name!",i,17'
set -x
./pg_hexedit -A "$ATTRLIST" -N testrel > t/output_attributes.hexpat || exit 1
set +x
check attributes t/expected_attributes.hexpat t/output_attributes.hexpat

# Block range window and forced segment number (relation-relative TIDs)
set -x
./pg_hexedit -A '4,"id",i,23' -R 100 199 -n 1 > t/output_range_segment.hexpat || exit 1
set +x
check range_segment t/expected_range_segment.hexpat t/output_range_segment.hexpat

if [ $fail -ne 0 ]
then
  exit 1
fi

echo ""
echo "All tests pass"
echo ""
echo "Tip: generate a pattern for one of your own relations and open it in"
echo "ImHex with:  ./relation_hexedit <relname>"
