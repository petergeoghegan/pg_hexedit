                       (i.child_bi_hi << 16) | i.child_bi_lo,
                       (i.key_bi_hi << 16) | i.key_bi_lo, i.key_posid);
};

// GIN posting tree leaf pages: chain of compressed posting list segments
struct GinPostingList {
    ItemPointerData first;
    u16 nbytes [[color("F1C40F")]];
    u8 varbyte_tids[nbytes] [[sealed, color("FF8C00")]];
    padding[(2 - ($ % 2)) % 2];	// SHORTALIGN between segments
} [[format("fmt_gin_posting_list")]];

fn fmt_gin_posting_list(ref auto l) {
    return std::format("first={} nbytes={}", fmt_ctid(l.first), l.nbytes);
};

