// ---------------- heap tuples ----------------

bitfield HeapInfomask2 {
    natts             : 11;	// HEAP_NATTS_MASK 0x07FF
    padding           : 2;
    HEAP_KEYS_UPDATED : 1;	// 0x2000
    HEAP_HOT_UPDATED  : 1;	// 0x4000
    HEAP_ONLY_TUPLE   : 1;	// 0x8000
} [[format("fmt_infomask2")]];

fn fmt_infomask2(ref auto m) {
    str s = "";
    if (m.HEAP_KEYS_UPDATED) s = s + "|HEAP_KEYS_UPDATED";
    if (m.HEAP_HOT_UPDATED)  s = s + "|HEAP_HOT_UPDATED";
    if (m.HEAP_ONLY_TUPLE)   s = s + "|HEAP_ONLY_TUPLE";
    return std::format("natts={}{}", m.natts, s);
};

bitfield HeapInfomask {
    HEAP_HASNULL          : 1;	// 0x0001
    HEAP_HASVARWIDTH      : 1;	// 0x0002
    HEAP_HASEXTERNAL      : 1;	// 0x0004
    HEAP_HASOID_OLD       : 1;	// 0x0008
    HEAP_XMAX_KEYSHR_LOCK : 1;	// 0x0010
    HEAP_COMBOCID         : 1;	// 0x0020
    HEAP_XMAX_EXCL_LOCK   : 1;	// 0x0040
    HEAP_XMAX_LOCK_ONLY   : 1;	// 0x0080
    HEAP_XMIN_COMMITTED   : 1;	// 0x0100
    HEAP_XMIN_INVALID     : 1;	// 0x0200
    HEAP_XMAX_COMMITTED   : 1;	// 0x0400
    HEAP_XMAX_INVALID     : 1;	// 0x0800
    HEAP_XMAX_IS_MULTI    : 1;	// 0x1000
    HEAP_UPDATED          : 1;	// 0x2000
    HEAP_MOVED_OFF        : 1;	// 0x4000
    HEAP_MOVED_IN         : 1;	// 0x8000
} [[format("fmt_infomask")]];

fn fmt_infomask(ref auto m) {
    str s = "";
    if (m.HEAP_HASNULL)          s = s + "HEAP_HASNULL|";
    if (m.HEAP_HASVARWIDTH)      s = s + "HEAP_HASVARWIDTH|";
    if (m.HEAP_HASEXTERNAL)      s = s + "HEAP_HASEXTERNAL|";
    if (m.HEAP_HASOID_OLD)       s = s + "HEAP_HASOID_OLD|";
    if (m.HEAP_XMAX_KEYSHR_LOCK) s = s + "HEAP_XMAX_KEYSHR_LOCK|";
    if (m.HEAP_COMBOCID)         s = s + "HEAP_COMBOCID|";
    if (m.HEAP_XMAX_EXCL_LOCK)   s = s + "HEAP_XMAX_EXCL_LOCK|";
    if (m.HEAP_XMAX_LOCK_ONLY)   s = s + "HEAP_XMAX_LOCK_ONLY|";
    if (m.HEAP_XMIN_COMMITTED)   s = s + "HEAP_XMIN_COMMITTED|";
    if (m.HEAP_XMIN_INVALID)     s = s + "HEAP_XMIN_INVALID|";
    if (m.HEAP_XMAX_COMMITTED)   s = s + "HEAP_XMAX_COMMITTED|";
    if (m.HEAP_XMAX_INVALID)     s = s + "HEAP_XMAX_INVALID|";
    if (m.HEAP_XMAX_IS_MULTI)    s = s + "HEAP_XMAX_IS_MULTI|";
    if (m.HEAP_UPDATED)          s = s + "HEAP_UPDATED|";
    if (m.HEAP_MOVED_OFF)        s = s + "HEAP_MOVED_OFF|";
    if (m.HEAP_MOVED_IN)         s = s + "HEAP_MOVED_IN|";
    if (std::string::length(s) == 0) return "(none)";
    return std::string::substr(s, 0, std::string::length(s) - 1);
};

struct HeapTupleHeaderData {
    u64 tupstart = $;
    u32 t_xmin                  [[color("E74C3C")]];
    u32 t_xmax                  [[color("CB3020")]];

    // t_field3 is the t_cid/t_xvac union; resolve it the way the old
    // tool did, by peeking at t_infomask for HEAP_MOVED bits
    if ((std::mem::read_unsigned($ + 12, 2) & 0xC000) != 0) {
        u32 t_xvac              [[color("E949D1")]];
    } else {
        u32 t_cid               [[color("912C21")]];
    }

    ItemPointerData t_ctid;
    HeapInfomask2 t_infomask2   [[color("1ABC9C")]];
    HeapInfomask t_infomask     [[color("16A085")]];
    u8  t_hoff                  [[color("E9E850")]];

    // Per-tuple natts governs the attribute walk, NOT the catalog count
    u16 tnatts = t_infomask2.natts;

    u16 bl = 0;
    if (t_infomask.HEAP_HASNULL) {
        bl = (tnatts + 7) / 8;
        u8 t_bits[bl] [[color("F1C40F")]];
    }

    // Sanity: t_hoff must be MAXALIGN(bitmap end).  If it is not, this
    // tuple is garbage; show the header but skip the attribute walk
    // instead of aborting the whole evaluation on negative padding.
    bool sane_hoff = t_hoff == ((23 + bl + 7) / 8) * 8;
    if (sane_hoff && g_item_end >= tupstart + t_hoff) {
        padding[t_hoff - 23 - bl];
        g_natts = tnatts;
        g_bits_addr = bl > 0 ? tupstart + 23 : 0;
        g_data_end = g_item_end;
        g_walk_bad = false;
        TupleAttrs attrs [[inline]];
    }
} [[format("fmt_heap_tuple")]];

// Collapsed-tuple summary.  Deliberately does NOT lead with t_ctid: for
// an updated tuple that is the successor, not this tuple.  The tuple's
// own TID goes into its display name in the naming pass.  Status the
// old tool conveyed with font colors rides along as text: FROZEN and
// ABORTED xmin; xmax shown only when it is not invalid.
fn fmt_heap_tuple(ref auto t) {
    str xmin = std::format("xmin={}", t.t_xmin);
    if (t.t_infomask.HEAP_XMIN_COMMITTED && t.t_infomask.HEAP_XMIN_INVALID)
        xmin = xmin + " FROZEN";
    else if (t.t_infomask.HEAP_XMIN_INVALID)
        xmin = xmin + " ABORTED";
    str xmax = "";
    if (!t.t_infomask.HEAP_XMAX_INVALID) {
        xmax = std::format(" xmax={}", t.t_xmax);
        if (t.t_infomask.HEAP_XMAX_IS_MULTI)
            xmax = xmax + " (multi)";
        if (t.t_infomask.HEAP_XMAX_LOCK_ONLY)
            xmax = xmax + " (lock only)";
    }
    return std::format("{}{} {} atts, ctid={}",
                       xmin, xmax, t.t_infomask2.natts, fmt_ctid(t.t_ctid));
};

// ---------------- index tuples ----------------

bitfield IndexTInfo {
    size               : 13;	// INDEX_SIZE_MASK 0x1FFF
    INDEX_AM_RESERVED  : 1;	// 0x2000 (nbtree: INDEX_ALT_TID_MASK)
    INDEX_VAR_MASK     : 1;	// 0x4000
    INDEX_NULL_MASK    : 1;	// 0x8000
} [[format("fmt_t_info")]];

fn fmt_t_info(ref auto m) {
    str s = "";
    if (m.INDEX_AM_RESERVED) {
        if (g_kind == 3) s = s + "|INDEX_ALT_TID_MASK";
        else if (g_kind == 4) s = s + "|INDEX_MOVED_BY_SPLIT_MASK";
        else s = s + "|INDEX_AM_RESERVED_BIT";
    }
    if (m.INDEX_VAR_MASK)  s = s + "|INDEX_VAR_MASK";
    if (m.INDEX_NULL_MASK) s = s + "|INDEX_NULL_MASK";
    return std::format("IndexTupleSize()={}{}", m.size, s);
};

struct BTPostingTid {
    u16 bi_hi                   [[color("E74C3C")]];
    u16 bi_lo                   [[color("CB3020")]];
    u16 ip_posid                [[color("1ABC9C")]];
} [[format("fmt_ctid")]];

struct BTPivotHeapTid {
    u16 bi_hi                   [[color("E949D1")]];
    u16 bi_lo                   [[color("CD2DB5")]];
    u16 ip_posid                [[color("E949D1")]];
} [[format("fmt_ctid")]];

struct IndexTupleData {
    u64 tupstart = $;
    g_walk_bad = false;
    ItemPointerData t_tid;
    IndexTInfo t_info           [[color("F1C40F")]];

    u32 itupsize = t_info.size;
    g_data_end = tupstart + itupsize;

    // nbtree tuples that abuse t_tid (see nbtree.h):
    //   pivot:   INDEX_ALT_TID_MASK && !(ip_posid & BT_IS_POSTING 0x2000)
    //   posting: INDEX_ALT_TID_MASK && (ip_posid & BT_IS_POSTING)
    bool bt_pivot = false;
    bool bt_posting = false;
    if (g_kind == 3 && t_info.INDEX_AM_RESERVED) {
        if ((t_tid.ip_posid & 0x2000) != 0) {
            bt_posting = true;
        } else {
            bt_pivot = true;
        }
    }

    // Attribute count for the walk: catalog count, except suffix
    // truncation makes it variable for nbtree pivot tuples
    u32 itnatts = 6;
    if (bt_pivot) {
        itnatts = t_tid.ip_posid & 0x0FFF;	// BTreeTupleGetNAtts()
        if (itnatts > 6) {
            g_walk_bad = true;
            itnatts = 6;
        }
        // Pivot tuples may store a heap TID tiebreaker in their final
        // 6 bytes (BTreeTupleGetHeapTID())
        if ((t_tid.ip_posid & 0x1000) != 0 && itupsize >= 14) {
            BTPivotHeapTid pivot_htid @ tupstart + itupsize - 6 [[no_unique_address]];
            g_data_end = tupstart + itupsize - 6;
        }
    }

    if (t_info.INDEX_NULL_MASK) {
        u8 nullbitmap[4] [[color("F1C40F"), name("IndexAttributeBitMapData")]];
        padding[4];
        g_bits_addr = tupstart + 8;
    } else {
        padding[0];
        g_bits_addr = 0;
    }

    // GIN main entry tree, leaf level: tuples can embed a compressed
    // posting list (posid = number of items, bi_lo = offset), or point
    // to a posting tree with magic offset GIN_TREE_POSTING
    if (g_kind == 6 && g_isleaf) {
        if (t_tid.ip_posid != 0xFFFF && t_tid.ip_posid > 0 &&
            t_tid.bi_lo >= 8 && t_tid.bi_lo <= itupsize) {
            u8 gin_posting[itupsize - t_tid.bi_lo] @ tupstart + t_tid.bi_lo [[sealed, no_unique_address, color("FF8C00")]];
            g_data_end = tupstart + t_tid.bi_lo;
        }
    }
    if (bt_posting) {
        // Deduplication posting list tuple: keys, then an array of
        // heap TIDs at BTreeTupleGetPostingOffset()
        u32 bt_nposting = t_tid.ip_posid & 0x0FFF;
        u32 bt_postingoff = (t_tid.bi_hi << 16) | t_tid.bi_lo;
        if (bt_postingoff >= 8 && bt_postingoff < itupsize &&
            bt_postingoff + bt_nposting * 6 <= itupsize) {
            BTPostingTid posting_tids[bt_nposting] @ tupstart + bt_postingoff [[no_unique_address]];
            g_data_end = tupstart + bt_postingoff;
        } else {
            g_walk_bad = true;
        }
    }

    if (g_kind == 6 && 6 > 1) g_walk_bad = true;
    g_natts = itnatts;
    if ($ <= g_data_end) {
        TupleAttrs attrs [[inline]];
    }
} [[format("fmt_index_tuple")]];

fn fmt_index_tuple(ref auto t) {
    return std::format("t_tid={} size={}", fmt_ctid(t.t_tid), t.t_info.size);
};

