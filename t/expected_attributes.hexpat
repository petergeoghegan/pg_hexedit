struct TupleAttrs {
    // attribute 1: "id"
    if (!g_walk_bad && g_natts >= 1 && att_present(0)) {
        padding[(4 - ($ % 4)) % 4];
        if ($ + 4 <= g_data_end) {
            s32 id [[color("C1B0AE")]];
        } else {
            g_walk_bad = true;
        }
    }
    // attribute 2: "flag"
    if (!g_walk_bad && g_natts >= 2 && att_present(1)) {
        if ($ + 1 <= g_data_end) {
            bool flag [[color("CAC6CE")]];
        } else {
            g_walk_bad = true;
        }
    }
    // attribute 3: "val"
    if (!g_walk_bad && g_natts >= 3 && att_present(2)) {
        padding[(8 - ($ % 8)) % 8];
        if ($ + 8 <= g_data_end) {
            s64 val [[color("BBC8EA")]];
        } else {
            g_walk_bad = true;
        }
    }
    // attribute 4: "........pg.dropped.4........"
    if (!g_walk_bad && g_natts >= 4 && att_present(3)) {
        u8 va_first_4 = std::mem::read_unsigned($, 1);
        if ((va_first_4 & 0x01) == 0x01) {
            if (va_first_4 == 0x01) {
                // TOAST pointer: 1-byte header with zero length
                if ($ + 2 + 16 <= g_data_end) {
                    pgvarlena_toast_dropped_4 dropped_4;
                } else {
                    g_walk_bad = true;
                }
            } else if ($ + (va_first_4 >> 1) <= g_data_end) {
                pgvarlena_1b_dropped_4 dropped_4;
            } else {
                g_walk_bad = true;
            }
        } else {
            padding[(4 - ($ % 4)) % 4];
            u32 va_hdr32_4 = std::mem::read_unsigned($, 4);
            if ((va_hdr32_4 & 0x03) == 0x02) {
                if ($ + (va_hdr32_4 >> 2) <= g_data_end && (va_hdr32_4 >> 2) >= 8) {
                    pgvarlena_4bc_dropped_4 dropped_4;
                } else {
                    g_walk_bad = true;
                }
            } else if ($ + (va_hdr32_4 >> 2) <= g_data_end && (va_hdr32_4 >> 2) >= 4) {
                pgvarlena_4b_dropped_4 dropped_4;
            } else {
                g_walk_bad = true;
            }
        }
    }
    // attribute 5: "name"
    if (!g_walk_bad && g_natts >= 5 && att_present(4)) {
        u8 va_first_5 = std::mem::read_unsigned($, 1);
        if ((va_first_5 & 0x01) == 0x01) {
            if (va_first_5 == 0x01) {
                // TOAST pointer: 1-byte header with zero length
                if ($ + 2 + 16 <= g_data_end) {
                    pgtext_toast_name name;
                } else {
                    g_walk_bad = true;
                }
            } else if ($ + (va_first_5 >> 1) <= g_data_end) {
                pgtext_1b_name name;
            } else {
                g_walk_bad = true;
            }
        } else {
            padding[(4 - ($ % 4)) % 4];
            u32 va_hdr32_5 = std::mem::read_unsigned($, 4);
            if ((va_hdr32_5 & 0x03) == 0x02) {
                if ($ + (va_hdr32_5 >> 2) <= g_data_end && (va_hdr32_5 >> 2) >= 8) {
                    pgtext_4bc_name name;
                } else {
                    g_walk_bad = true;
                }
            } else if ($ + (va_hdr32_5 >> 2) <= g_data_end && (va_hdr32_5 >> 2) >= 4) {
                pgtext_4b_name name;
            } else {
                g_walk_bad = true;
            }
        }
    }
    // attribute 6: "strange name!"
    if (!g_walk_bad && g_natts >= 6 && att_present(5)) {
        u8 va_first_6 = std::mem::read_unsigned($, 1);
        if ((va_first_6 & 0x01) == 0x01) {
            if (va_first_6 == 0x01) {
                // TOAST pointer: 1-byte header with zero length
                if ($ + 2 + 16 <= g_data_end) {
                    pgvarlena_toast_att6 att6;
                } else {
                    g_walk_bad = true;
                }
            } else if ($ + (va_first_6 >> 1) <= g_data_end) {
                pgvarlena_1b_att6 att6;
            } else {
                g_walk_bad = true;
            }
        } else {
            padding[(4 - ($ % 4)) % 4];
            u32 va_hdr32_6 = std::mem::read_unsigned($, 4);
            if ((va_hdr32_6 & 0x03) == 0x02) {
                if ($ + (va_hdr32_6 >> 2) <= g_data_end && (va_hdr32_6 >> 2) >= 8) {
                    pgvarlena_4bc_att6 att6;
                } else {
