bitfield BTPageFlags {
    BTP_LEAF             : 1;	// 0x0001
    BTP_ROOT             : 1;	// 0x0002
    BTP_DELETED          : 1;	// 0x0004
    BTP_META             : 1;	// 0x0008
    BTP_HALF_DEAD        : 1;	// 0x0010
    BTP_SPLIT_END        : 1;	// 0x0020
    BTP_HAS_GARBAGE      : 1;	// 0x0040
    BTP_INCOMPLETE_SPLIT : 1;	// 0x0080
    BTP_HAS_FULLXID      : 1;	// 0x0100
    padding              : 7;
} [[format("fmt_btpo_flags")]];

fn fmt_btpo_flags(ref auto f) {
    str s = "";
    if (f.BTP_LEAF)             s = s + "BTP_LEAF|";
    if (f.BTP_ROOT)             s = s + "BTP_ROOT|";
    if (f.BTP_DELETED)          s = s + "BTP_DELETED|";
    if (f.BTP_META)             s = s + "BTP_META|";
    if (f.BTP_HALF_DEAD)        s = s + "BTP_HALF_DEAD|";
    if (f.BTP_SPLIT_END)        s = s + "BTP_SPLIT_END|";
    if (f.BTP_HAS_GARBAGE)      s = s + "BTP_HAS_GARBAGE|";
    if (f.BTP_INCOMPLETE_SPLIT) s = s + "BTP_INCOMPLETE_SPLIT|";
    if (f.BTP_HAS_FULLXID)      s = s + "BTP_HAS_FULLXID|";
    if (std::string::length(s) == 0) return "(none)";
    return std::string::substr(s, 0, std::string::length(s) - 1);
};

