};

bitfield BrinInfo {
    offset               : 5;	// BRIN_OFFSET_MASK 0x1F
    padding              : 1;
    BRIN_PLACEHOLDER     : 1;	// 0x40
    BRIN_NULLS           : 1;	// 0x80
} [[format("fmt_brin_info")]];

fn fmt_brin_info(ref auto i) {
    str s = "";
    if (i.BRIN_PLACEHOLDER) s = s + "|BRIN_PLACEHOLDER_MASK";
    if (i.BRIN_NULLS)       s = s + "|BRIN_NULLS_MASK";
    return std::format("BrinTupleDataOffset()={}{}", i.offset, s);
};

struct BrinTupleData {
    u64 btupstart = $;
    u32 bt_blkno [[color("3498DB")]];
    BrinInfo bt_info [[color("F1C40F")]];
    if (bt_info.BRIN_NULLS && btupstart + bt_info.offset > $) {
        u8 nullbits[btupstart + bt_info.offset - $] [[sealed, color("F1C40F"), name("IndexAttributeBitMapData")]];
    }
    if (g_item_end > btupstart + bt_info.offset) {
        padding[btupstart + bt_info.offset - $];
        u8 contents[g_item_end - $] [[sealed, color("CCD1D1")]];
    }
} [[format("fmt_brin_tuple")]];

fn fmt_brin_tuple(ref auto t) {
    return std::format("bt_blkno={} {}", t.bt_blkno, fmt_brin_info(t.bt_info));
};

struct RawSpecial {
    u8 opaque[8192 - g_special_off] [[sealed, color("50E964")]];
};

// ---------------- line pointer slots ----------------

// Slot structs walk the line pointer array (each element consumes one
// 4-byte ItemIdData) but present the TUPLE as the primary object: the
// placed tuple is the first child, and the line pointer itself is the
// last child, for drill-down.  Line pointer fields are peeked up front
// so placement can precede the sequential ItemIdData member.
struct HeapTupleSlot {
    u32 lpraw = std::mem::read_unsigned($, 4);
    u32 p_off = lpraw & 0x7FFF;
    u8  p_flags = (lpraw >> 15) & 3;
    u32 p_len = (lpraw >> 17) & 0x7FFF;
    // LP_DEAD heap items can retain storage until pruned; annotate them
    if ((p_flags == 1 || p_flags == 3) && p_len != 0) {
        g_item_end = (($ / 8192) * 8192) + p_off + p_len;
        HeapTupleHeaderData htup @ (($ / 8192) * 8192) + p_off [[no_unique_address]];
    }
    ItemIdData lp;
} [[format("fmt_slot")]];

struct IndexTupleSlot {
    u32 lpraw = std::mem::read_unsigned($, 4);
    u32 p_off = lpraw & 0x7FFF;
    u8  p_flags = (lpraw >> 15) & 3;
    u32 p_len = (lpraw >> 17) & 0x7FFF;
    // Index AMs use LP_DEAD for dead-but-still-present tuples, so both
    // LP_NORMAL and LP_DEAD items have storage (p_len != 0 guards it)
    if ((p_flags == 1 || p_flags == 3) && p_len != 0) {
        g_item_end = (($ / 8192) * 8192) + p_off + p_len;
        IndexTupleData itup @ (($ / 8192) * 8192) + p_off [[no_unique_address]];
    }
    ItemIdData lp;
} [[format("fmt_slot")]];

struct RawItemSlot {
    u32 lpraw = std::mem::read_unsigned($, 4);
    u32 p_off = lpraw & 0x7FFF;
    u8  p_flags = (lpraw >> 15) & 3;
    u32 p_len = (lpraw >> 17) & 0x7FFF;
    if (p_len != 0 && p_flags != 0) {
        u8 item[p_len] @ (($ / 8192) * 8192) + p_off [[sealed, no_unique_address, color("CCD1D1")]];
    }
    ItemIdData lp;
} [[format("fmt_slot")]];

struct SpgSlot {
    u32 lpraw = std::mem::read_unsigned($, 4);
    u32 p_off = lpraw & 0x7FFF;
    u8  p_flags = (lpraw >> 15) & 3;
    u32 p_len = (lpraw >> 17) & 0x7FFF;
    if (p_len != 0 && p_flags != 0) {
        g_item_end = (($ / 8192) * 8192) + p_off + p_len;
        if (g_isleaf) {
            SpGistLeafTuple sleaf @ (($ / 8192) * 8192) + p_off [[no_unique_address]];
        } else {
            SpGistInnerTuple sinner @ (($ / 8192) * 8192) + p_off [[no_unique_address]];
        }
    }
    ItemIdData lp;
} [[format("fmt_slot")]];

struct BrinSlot {
    u32 lpraw = std::mem::read_unsigned($, 4);
    u32 p_off = lpraw & 0x7FFF;
    u8  p_flags = (lpraw >> 15) & 3;
    u32 p_len = (lpraw >> 17) & 0x7FFF;
    if (p_len != 0 && p_flags == 1) {
        g_item_end = (($ / 8192) * 8192) + p_off + p_len;
        BrinTupleData btup @ (($ / 8192) * 8192) + p_off [[no_unique_address]];
    }
    ItemIdData lp;
} [[format("fmt_slot")]];

fn fmt_slot(ref auto s) { return fmt_itemid(s.lp); };

// ---------------- pages ----------------

fn page_kind_str(u8 kind) {
    match (kind) {
        (1): return "heap";
        (2): return "sequence";
        (3): return "nbtree";
        (4): return "hash";
        (5): return "GiST";
        (6): return "GIN";
        (7): return "SP-GiST";
        (8): return "BRIN";
    }
    return "unknown";
};

struct Page {
    u64 pagebase = $;
    g_blk = ($ / 8192) + BASE_BLOCK;
    PageHeaderData header;

    bool intagrange = (pagebase / 8192) >= FIRST_TAG_BLOCK && (pagebase / 8192) <= LAST_TAG_BLOCK;

    // ---- page kind classification (GetSpecialSectionType() port) ----
    g_kind = 0;
    g_special_off = header.pd_special;
    u32 specialsize = 8192 - header.pd_special;
    u16 pagetype = std::mem::read_unsigned(pagebase + 8190, 2);

    bool validpage = header.pd_pagesize_version != 0 && header.pd_special <= 8192 &&
        header.pd_lower >= 24 && header.pd_lower <= 8192;
    if (validpage) {
        if (specialsize == 0) {
            g_kind = 1;
        }
        else if (specialsize == 8 && std::mem::read_unsigned(pagebase + header.pd_special, 4) == 0x1717) {
            g_kind = 2;
        }
        else if (specialsize == 8 && pagetype == 0xFF82) {
            g_kind = 7;
        }
        else if (specialsize == 8 && (pagetype == 0xF091 || pagetype == 0xF092 || pagetype == 0xF093)) {
            g_kind = 8;
        }
        else if (specialsize == 8) {
            g_kind = 6;
        }
        else if (specialsize == 16 && pagetype <= 0xFF7F) {
            g_kind = 3;
        }
        else if (specialsize == 16 && pagetype == 0xFF80) {
            g_kind = 4;
        }
        else if (specialsize == 16 && pagetype == 0xFF81) {
            g_kind = 5;
        }
    }


    // Persist kind/validity as (calculated) members so the naming pass
    // can label pages accurately -- in particular so empty/pad pages
    // are not mislabeled as heap.
    u8 page_kind = g_kind;
    bool page_valid = validpage;

    // ---- page body ----
    if (validpage && intagrange) {
        u32 nlinp = (header.pd_lower - 24) / 4;

        // Per-AM page state, peeked from the special section
        bool ismeta = g_blk == 0 && (g_kind == 3 || g_kind == 4 || g_kind == 6 || g_kind == 7 || g_kind == 8);
        bool skiptuples = false;
        bool hashbitmap = false;
        bool gindata = false;
        u16 amflags = 0;
        g_isleaf = false;
        if (g_kind == 4) {
            amflags = std::mem::read_unsigned(pagebase + header.pd_special + 12, 2);
            if ((amflags & 0x0004) != 0) hashbitmap = true;
        }
        if (g_kind == 5) {
            amflags = std::mem::read_unsigned(pagebase + header.pd_special + 12, 2);
            if ((amflags & 0x0002) != 0) skiptuples = true;	// F_DELETED
        }
        if (g_kind == 7) {
            amflags = std::mem::read_unsigned(pagebase + header.pd_special + 0, 2);
            if ((amflags & 0x0002) != 0) skiptuples = true;	// SPGIST_DELETED
            if ((amflags & 0x0004) != 0) g_isleaf = true;
        }
        if (g_kind == 6) {
            amflags = std::mem::read_unsigned(pagebase + header.pd_special + 6, 2);
            if ((amflags & 0x0004) != 0) skiptuples = true;	// GIN_DELETED
            if ((amflags & 0x0002) != 0) g_isleaf = true;
            if ((amflags & 0x0001) != 0) gindata = true;
        }

        if (ismeta) {
            if (g_kind == 3) {
                BTMetaPageData btree_meta;
            } else if (g_kind == 4) {
                HashMetaPageData hash_meta;
            } else if (g_kind == 6) {
                GinMetaPageData gin_meta;
            } else if (g_kind == 7) {
                SpGistMetaPageData spgist_meta;
            } else if (g_kind == 8) {
                BrinMetaPageData brin_meta;
            }
        }
        else if (g_kind == 4 && hashbitmap) {
            g_content_len = header.pd_lower - 24;
            HashBitmapContent hash_bitmap;
        }
        else if (g_kind == 6 && gindata && !skiptuples) {
            // Posting tree pages have no line pointer array
            if (!g_isleaf) {
                u16 ginmaxoff = std::mem::read_unsigned(pagebase + header.pd_special + 4, 2);
                if (ginmaxoff * 10 <= 8192) {
                    GinPostingItem posting_items[ginmaxoff];
                }
            } else if ((amflags & 0x0080) != 0) {
                GinPostingList posting_lists[while($ < pagebase + header.pd_lower)];
            }
        }
        else if (skiptuples) {
            // deleted page: annotate header/special only
        }
        else if (g_kind == 1 || g_kind == 2) {
            HeapTupleSlot linp[nlinp];
        }
        else if (g_kind == 8 && pagetype == 0xF092) {
            BrinRevmapContents revmap;
        }
        else if (g_kind == 3 || g_kind == 4 || g_kind == 5 || g_kind == 6) {
            IndexTupleSlot linp[nlinp];
        }
        else if (g_kind == 7) {
            SpgSlot linp[nlinp];
        }
        else if (g_kind == 8) {
            BrinSlot linp[nlinp];
        }
        else if (g_kind != 0) {
            RawItemSlot linp[nlinp];
        }

        // ---- special section ----
        if (g_kind == 3) {
            BTPageOpaqueData btree_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind == 4) {
            HashPageOpaqueData hash_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind == 5) {
            GISTPageOpaqueData gist_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind == 6) {
            GinPageOpaqueData gin_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind == 7) {
            SpGistPageOpaqueData spgist_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind == 8) {
            BrinSpecial brin_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind == 2) {
            SequenceMagic sequence_special @ pagebase + header.pd_special [[no_unique_address]];
        }
        else if (g_kind != 1 && specialsize > 0) {
            RawSpecial raw_special @ pagebase + header.pd_special [[no_unique_address]];
        }
    }

    padding[8192 - ($ % 8192)];
} [[format("fmt_page")]];

fn fmt_page(ref auto p) {
    return std::format("lower={} upper={} special={}",
                       p.header.pd_lower, p.header.pd_upper, p.header.pd_special);
};

// ---------------- provider cache flush + live sizing ----------------
// ImHex's GDB Server provider caches reads (1024 direct-mapped 4KiB
// lines, no reload).  pg_hexedit_live_bridge advertises an 8MiB pad
// past the relation and tags the pad's last line with a magic value
// and the live relation size.  Each evaluation:
//   1. flushes the metadata line's cache slot via a pad alias,
//   2. reads the live relation size (so growth is tracked),
//   3. flushes exactly the slots that can hold relation lines, by
//      reading pad addresses that alias them (blockIndex mod 1024).
// On plain files there is no pad: every alias lands past the end of
// the file and the whole sweep self-disables at zero cost.
u64 cf_size = std::mem::size();
u64 cf_lines = cf_size / 4096;

// (1) make the metadata line's slot fetch fresh
if (cf_lines >= 1025) {
    std::mem::read_unsigned((cf_lines - 1 - 1024) * 4096, 1);
}

// (2) live relation size from the bridge tag, else file size
u64 g_npages = cf_size / 8192;
bool cf_bridged = false;
if (cf_size >= 4096 &&
    std::mem::read_unsigned(cf_size - 4096, 8) == 0x3147524258484750) {
    g_npages = std::mem::read_unsigned(cf_size - 4088, 8) / 8192;
    cf_bridged = true;
}

// (3) flush the relation's cache slots through their pad aliases
u64 cf_rel_lines = g_npages * 2;
u64 cf_nflush = cf_rel_lines;
if (cf_nflush > 1024) cf_nflush = 1024;
u64 cf_p0 = ((cf_rel_lines + 1023) / 1024) * 1024;
u64 cf_addr = 0;
if (cf_bridged) {
    for (u64 cf = 0, cf < cf_nflush, cf += 1) {
        cf_addr = (cf_p0 + cf) * 4096;
        if (cf_addr < cf_size) {
            std::mem::read_unsigned(cf_addr, 1);
        }
    }
} else if (cf_size < 0x800000) {
    // Bridge provider created without the padded size?  (Plain small
    // files also land here; the note is only relevant to the bridge.)
    std::print("pg_hexedit: no live-bridge tag found; if this is the GDB provider, re-create it with the padded size the bridge prints (File -> Recent has a pre-configured entry), or re-evaluation will show stale bytes");
}

// Page count.  g_npages (from the live bridge's size tag, else the
// data-source size) is the primary bound.  As a safety net against a
// live provider whose size does not match the bridge, stop at the
// bridge's flush-pad sentinel: the bridge fills pad pages with 0xFF, so
// pd_pagesize_version reads 0xFFFF there -- a value no real page has.
// Real pages, including all-zero uninitialized holes, are kept (0 is
// not the sentinel), and plain files never contain the sentinel.
Page pages[while(($ / 8192) < g_npages && $ + 8192 <= std::mem::size() &&
                std::mem::read_unsigned($ + 18, 2) != 0xFFFF)] @ 0x00;

// ---------------- naming + coloring pass ----------------

u32 lpcolor = 0;
u32 pageblk = 0;
str pagekind = "";
bool hastup = false;

for (u32 p = 0, p < std::core::member_count(pages), p += 1) {
    pageblk = p + BASE_BLOCK;
    if (std::core::has_member(pages[p], "linp")) {
        for (u32 s = 0, s < std::core::member_count(pages[p].linp), s += 1) {
            // The slot row carries the tuple's identity; the line
            // pointer is the drill-down (its own row sits last inside)
            hastup = std::core::has_member(pages[p].linp[s], "htup") ||
                     std::core::has_member(pages[p].linp[s], "itup") ||
                     std::core::has_member(pages[p].linp[s], "sleaf") ||
                     std::core::has_member(pages[p].linp[s], "sinner") ||
                     std::core::has_member(pages[p].linp[s], "btup");
            if (hastup) {
                std::core::set_display_name(pages[p].linp[s],
                    std::format("tuple ({},{})", pageblk, s + 1));
                std::core::set_pattern_comment(pages[p].linp[s],
                    std::format("lp {}", s + 1));
            } else {
                std::core::set_display_name(pages[p].linp[s],
                    std::format("lp {}", s + 1));
            }

            // Line pointer state colors (parity-shaded within a state
            // so adjacent same-state line pointers remain separable)
            if (pages[p].linp[s].lp.lp_flags == 0)
                lpcolor = (s & 1) == 0 ? 0x70968B80 : 0x707A6F64;	// LP_UNUSED: muted gray
            else if (pages[p].linp[s].lp.lp_flags == 2)
                lpcolor = (s & 1) == 0 ? 0x70B98029 : 0x709D640D;	// BLUE_DARK
            else if (pages[p].linp[s].lp.lp_flags == 3)
                lpcolor = (s & 1) == 0 ? 0x703D3397 : 0x7021177B;	// BROWN
            else
                lpcolor = (s & 1) == 0 ? 0x70DB9834 : 0x70BF7C18;	// BLUE_LIGHT
            std::core::set_pattern_color(pages[p].linp[s].lp, lpcolor);

            if (std::core::has_member(pages[p].linp[s], "htup"))
                std::core::set_pattern_comment(pages[p].linp[s].htup,
                    std::format("TID ({},{})", pageblk, s + 1));
            if (std::core::has_member(pages[p].linp[s], "sleaf"))
                std::core::set_pattern_comment(pages[p].linp[s].sleaf,
                    std::format("leaf tuple ({},{})", pageblk, s + 1));
            if (std::core::has_member(pages[p].linp[s], "sinner"))
                std::core::set_pattern_comment(pages[p].linp[s].sinner,
                    std::format("inner tuple ({},{})", pageblk, s + 1));
            if (std::core::has_member(pages[p].linp[s], "btup"))
                std::core::set_pattern_comment(pages[p].linp[s].btup,
                    std::format("brin tuple ({},{})", pageblk, s + 1));
            if (std::core::has_member(pages[p].linp[s], "itup")) {
                if (pages[p].linp[s].lp.lp_flags == 3)
                    std::core::set_pattern_comment(pages[p].linp[s].itup,
                        std::format("index tuple ({},{}) LP_DEAD", pageblk, s + 1));
                else
                    std::core::set_pattern_comment(pages[p].linp[s].itup,
                        std::format("index tuple ({},{})", pageblk, s + 1));

                // nbtree posting list TIDs alternate colors per entry,
                // as the old tool did, so runs of TIDs stay readable
                if (std::core::has_member(pages[p].linp[s].itup, "posting_tids")) {
                    for (u32 t = 0, t < std::core::member_count(pages[p].linp[s].itup.posting_tids), t += 1) {
                        if (pages[p].linp[s].lp.lp_flags == 3)
                            lpcolor = 0x703D3397;	// LP_DEAD: BROWN
                        else if ((t & 1) == 0)
                            lpcolor = 0x703C4CE7;	// RED_LIGHT
                        else
                            lpcolor = 0x709CBC1A;	// GREEN_LIGHT
                        std::core::set_pattern_color(pages[p].linp[s].itup.posting_tids[t], lpcolor);
                    }
                }

                // LP_DEAD index tuples keep storage; paint the whole
                // tuple in the line pointer's dead color, as the old
                // tool did with its black-tag/brown-font scheme
                if (pages[p].linp[s].lp.lp_flags == 3) {
                    std::core::set_pattern_color(pages[p].linp[s].itup, 0x703D3397);
                    std::core::set_pattern_color(pages[p].linp[s].itup.t_tid, 0x703D3397);
                    std::core::set_pattern_color(pages[p].linp[s].itup.t_info, 0x703D3397);
                    if (std::core::has_member(pages[p].linp[s].itup, "attrs")) {
                        if (std::core::has_member(pages[p].linp[s].itup.attrs, "dropped_4"))
                            std::core::set_pattern_color(pages[p].linp[s].itup.attrs.dropped_4, 0x703D3397);
                        if (std::core::has_member(pages[p].linp[s].itup.attrs, "name"))
                            std::core::set_pattern_color(pages[p].linp[s].itup.attrs.name, 0x703D3397);
                        if (std::core::has_member(pages[p].linp[s].itup.attrs, "att6"))
                            std::core::set_pattern_color(pages[p].linp[s].itup.attrs.att6, 0x703D3397);
                    }
                }
            }
        }
    }

    // Page label: derived from what the page actually is.  A page with
    // no recognized special section is only "heap" if it is a valid
    // page classified as heap; invalid/uninitialized pages (e.g. the
    // live bridge's flush pad) must not be mislabeled heap.
    pagekind = "unrecognized";
    if (!pages[p].page_valid)
        pagekind = "empty/uninitialized";
    else if (pages[p].page_kind == 1)
        pagekind = "heap";
    else if (std::core::has_member(pages[p], "btree_meta"))
        pagekind = "nbtree metapage";
    else if (std::core::has_member(pages[p], "btree_special"))
        pagekind = std::format("nbtree level {}", pages[p].btree_special.btpo_level);
    else if (std::core::has_member(pages[p], "hash_meta"))
        pagekind = "hash metapage";
    else if (std::core::has_member(pages[p], "hash_bitmap"))
        pagekind = "hash bitmap";
    else if (std::core::has_member(pages[p], "hash_special"))
        pagekind = std::format("hash bucket {}", pages[p].hash_special.hasho_bucket);
    else if (std::core::has_member(pages[p], "gin_meta"))
        pagekind = "GIN metapage";
    else if (std::core::has_member(pages[p], "posting_items"))
        pagekind = "GIN posting tree internal";
    else if (std::core::has_member(pages[p], "posting_lists"))
        pagekind = "GIN posting tree leaf";
    else if (std::core::has_member(pages[p], "gin_special"))
        pagekind = "GIN entry tree";
    else if (std::core::has_member(pages[p], "gist_special"))
        pagekind = "GiST";
    else if (std::core::has_member(pages[p], "spgist_meta"))
        pagekind = "SP-GiST metapage";
    else if (std::core::has_member(pages[p], "spgist_special"))
        pagekind = "SP-GiST";
    else if (std::core::has_member(pages[p], "brin_meta"))
        pagekind = "BRIN metapage";
    else if (std::core::has_member(pages[p], "revmap"))
        pagekind = "BRIN revmap";
    else if (std::core::has_member(pages[p], "brin_special"))
        pagekind = "BRIN regular";
    else if (std::core::has_member(pages[p], "sequence_special"))
        pagekind = "sequence";
    else if (std::core::has_member(pages[p], "raw_special"))
        pagekind = "index";
    std::core::set_display_name(pages[p],
        std::format("block {} ({})", pageblk, pagekind));
}

