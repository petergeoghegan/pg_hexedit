struct GinPostingItem {
    u16 child_bi_hi  [[color("3498DB")]];
    u16 child_bi_lo  [[color("187CBF")]];
    u16 key_bi_hi    [[color("CCD1D1")]];
    u16 key_bi_lo    [[color("B0B5B5")]];
    u16 key_posid    [[color("CCD1D1")]];
} [[format("fmt_gin_posting_item")]];

