// PostgreSQL relation file annotations for ImHex.
// Generated by pg_hexedit 0.2 for PostgreSQL 20devel, relation: testrel
// Options: -A 4,"id",i,23,1,"flag",c,16,8,"val",d,20,-1,"........pg.dropped.4........",i,0,-1,"name",i,25,-1,"strange name!",i,17 -N testrel
// Generated on: 2026-08-27 20:08:23
// Build parameters: BLCKSZ=8192 MAXIMUM_ALIGNOF=8 INDEX_MAX_KEYS=32 RELSEG_SIZE=131072
//
// All struct layouts, offsets, and flag masks in this file were computed
// with sizeof/offsetof against the PostgreSQL headers at generation time.

#pragma description PostgreSQL relation file testrel (pg_hexedit)
// Match any PostgreSQL page file: pd_pagesize_version on block 0.
// When this pattern sits in ImHex's user patterns folder, ImHex offers
// to apply it automatically whenever a matching file is opened.
#pragma magic [ 04 20 ] @ 0x12
#pragma endian little
#pragma pattern_limit 0x1000000
#pragma array_limit 0x100000

import std.core;
import std.io;
import std.mem;
import std.string;

// Only blocks in this (file-relative) range are fully annotated; others
// get page headers only.  Regenerate with -R to move the window.
u32 FIRST_TAG_BLOCK = 0;
u32 LAST_TAG_BLOCK = 2147483647;
u32 BASE_BLOCK = 0;      // segment number 0 at 131072 blocks per segment

// Per-page/per-tuple evaluation state (see generator comments)
u8  g_kind = 0;
u32 g_blk = 0;          // relation-relative block number of current page
bool g_isleaf = false;  // page-level leaf flag (GIN entry / SP-GiST)
u64 g_item_end = 0;     // absolute end of current item's storage
u32 g_natts = 0;        // attribute walk: this tuple's attribute count
u64 g_bits_addr = 0;    // attribute walk: NULL bitmap address (0 = no NULLs)
u64 g_data_end = 0;     // attribute walk: absolute end of tuple data
bool g_walk_bad = false; // attribute walk: stop decoding this tuple
u32 g_special_off = 0;  // current page's pd_special
u32 g_content_len = 0;  // page content length for raw regions

fn att_present(u32 attno) {
    if (g_bits_addr == 0)
        return true;
    return ((std::mem::read_unsigned(g_bits_addr + (attno >> 3), 1) >> (attno & 7)) & 1) != 0;
};

// ---------------- page header ----------------

// Unsealed so xlogid and xrecoff are individually editable in Pattern
// Data (in live --writable mode, edits poke shared_buffers); the
// collapsed row still reads X/XXXXXXXX via the format.
struct PageXLogRecPtr {
    u32 xlogid;
    u32 xrecoff;
} [[format("fmt_lsn")]];

fn fmt_lsn(ref auto l) {
    return std::format("{:X}/{:08X}", l.xlogid, l.xrecoff);
};

bitfield PageFlags {
    PD_HAS_FREE_LINES : 1;	// 0x0001
    PD_PAGE_FULL      : 1;	// 0x0002
    PD_ALL_VISIBLE    : 1;	// 0x0004
    padding           : 13;
} [[format("fmt_pd_flags")]];

fn fmt_pd_flags(ref auto f) {
    str s = "";
    if (f.PD_HAS_FREE_LINES) s = s + "PD_HAS_FREE_LINES|";
    if (f.PD_PAGE_FULL)      s = s + "PD_PAGE_FULL|";
    if (f.PD_ALL_VISIBLE)    s = s + "PD_ALL_VISIBLE|";
    if (std::string::length(s) == 0) return "(none)";
    return std::string::substr(s, 0, std::string::length(s) - 1);
};

struct PageHeaderData {
    PageXLogRecPtr pd_lsn       [[color("E9E850")]];
    u16 pd_checksum             [[color("16A085")]];
    PageFlags pd_flags          [[color("F1C40F")]];
    u16 pd_lower                [[color("E96950")]];
    u16 pd_upper                [[color("CD4D34")]];
    u16 pd_special              [[color("50E964")]];
    u16 pd_pagesize_version     [[color("97333D")]];
    u32 pd_prune_xid            [[color("E74C3C")]];
};

// ---------------- line pointers ----------------

fn lp_flags_str(u8 f) {
    match (f) {
        (0): return "LP_UNUSED";
        (1): return "LP_NORMAL";
        (2): return "LP_REDIRECT";
        (3): return "LP_DEAD";
    }
    return "?";
};

bitfield ItemIdData {
    lp_off   : 15;
    lp_flags : 2;
    lp_len   : 15;
} [[format("fmt_itemid")]];

fn fmt_itemid(ref auto lp) {
    if (lp.lp_flags == 0 && lp.lp_off == 0 && lp.lp_len == 0)
        return "LP_UNUSED";
    if (lp.lp_flags == 2)
        return std::format("LP_REDIRECT -> lp {}", lp.lp_off);
    return std::format("{} off={} len={}",
                       lp_flags_str(lp.lp_flags), lp.lp_off, lp.lp_len);
};

// ---------------- item pointers ----------------

struct ItemPointerData {
    u16 bi_hi                   [[color("3498DB")]];
    u16 bi_lo                   [[color("187CBF")]];
    u16 ip_posid                [[color("2980B9")]];
} [[format("fmt_ctid")]];

fn fmt_ctid(ref auto c) {
    return std::format("({},{})", (c.bi_hi << 16) | c.bi_lo, c.ip_posid);
};

// ---------------- attribute values ----------------

fn fmt_att_str(ref auto a) { return std::format("\"{}\"", a.data); };
fn fmt_att_bin(ref auto a) { return std::format("{} bytes", sizeof(a.data)); };
fn fmt_att_toast(ref auto a) {
    return std::format("TOAST valueid={} rawsize={}", a.va_valueid, a.va_rawsize);
};
fn fmt_att_point(ref auto a) { return std::format("({},{})", a.x, a.y); };
fn fmt_att_compressed(ref auto a) {
    return std::format("compressed ({} bytes)", (a.va_header >> 2) - 8);
};

// Fixed scalar columns are emitted as bare typed members in the walk
// (below), so their values are directly editable in the Pattern Data
// view.  Only types that genuinely need a struct keep one: point pairs
// its two doubles (unsealed, so x and y stay individually editable
// while the collapsed row still reads "(x,y)"), and varlena keeps its
// header/value split.
struct pgpoint { double x; double y; } [[format("fmt_att_point")]];

