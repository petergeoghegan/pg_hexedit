fn spgist_state_str(u8 st) {
    match (st) {
        (0): return "SPGIST_LIVE";
        (1): return "SPGIST_REDIRECT";
        (2): return "SPGIST_DEAD";
        (3): return "SPGIST_PLACEHOLDER";
    }
    return "?";
};

bitfield SpgInnerHead {
    tupstate   : 2;
    allTheSame : 1;
    nNodes     : 13;
    prefixSize : 16;
} [[format("fmt_spg_inner_head")]];

fn fmt_spg_inner_head(ref auto h) {
    return std::format("{} allTheSame={} nNodes={} prefixSize={}",
                       spgist_state_str(h.tupstate), h.allTheSame, h.nNodes, h.prefixSize);
};

// SP-GiST node tuples reuse the IndexTuple layout for downlink labels
struct SpgNodeTuple {
    ItemPointerData t_tid;
    IndexTInfo t_info [[color("F1C40F")]];
    if (t_info.size >= 8) {
        u8 label[t_info.size - 8] [[sealed, color("CCD1D1")]];
    }
} [[format("fmt_index_tuple")]];

struct SpGistInnerTuple {
    u64 stupstart = $;
    SpgInnerHead head [[color("E9E850")]];
    u16 size [[color("CDCC34")]];
    if (head.tupstate == 0) {
        if (head.prefixSize > 0) {
            u8 prefix[head.prefixSize] [[sealed, color("CCD1D1")]];
        }
        SpgNodeTuple nodes[head.nNodes];
    } else if (g_item_end > $) {
        u8 contents[g_item_end - $] [[sealed, color("97333D")]];
    }
} [[format("fmt_spg_inner")]];

fn fmt_spg_inner(ref auto t) { return fmt_spg_inner_head(t.head); };

bitfield SpgLeafHead {
    tupstate : 2;
    size     : 30;
} [[format("fmt_spg_leaf_head")]];

fn fmt_spg_leaf_head(ref auto h) {
    return std::format("{} size={}", spgist_state_str(h.tupstate), h.size);
};

struct SpGistLeafTuple {
    u64 stupstart = $;
    SpgLeafHead head [[color("E9E850")]];
    u16 nextOffset [[color("F1C40F"), format("fmt_spg_nextoffset")]];
    ItemPointerData heapPtr;
    if (head.tupstate == 0) {
        if (stupstart + head.size > $ && head.size <= 8192) {
            u8 contents[stupstart + head.size - $] [[sealed, color("CCD1D1")]];
        }
    } else {
        u32 xid [[color("E74C3C")]];
    }
} [[format("fmt_spg_leaf")]];

fn fmt_spg_nextoffset(auto v) {
    return std::format("{}{}", v & 0x7FFF, (v & 0x8000) != 0 ? " (has nullmask)" : "");
};

fn fmt_spg_leaf(ref auto t) {
    return std::format("{} heapPtr={}", fmt_spg_leaf_head(t.head), fmt_ctid(t.heapPtr));
};

